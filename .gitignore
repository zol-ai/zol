# Monorepo root. Each app under apps/ has its own .gitignore with
# app-specific rules; these cover every workspace.

# Secrets — never commit. Each app tracks a .env.example template.
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
.next/
out/
build/
dist/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

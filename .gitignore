# Secrets — never commit. Use .env.example as the tracked template.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
.next/
out/
build/
dist/

# Vercel / GCP
.vercel
# (.gcloudignore is tracked — it defines the Cloud Build context)

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Large source recordings. The written transcript and the notes photo stay
# tracked — they're the requirements this was built from.
*.mp4
*.m4a
*.wav

# TypeScript
*.tsbuildinfo

# Service-account keys minted by infra/vercel-env.ps1. Long-lived credentials
# — they belong in the secret store, never in the repo.
infra/.keys/
*.json.key

# Reserved for a future Auth.js migration; not used by the Firebase-only MVP.
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Google OAuth configuration is managed in Firebase Authentication for this MVP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ALLOWED_EMAILS=founder1@example.com,founder2@example.com
COMPANY_TIME_ZONE=America/Los_Angeles

# Company Brain — server only. Never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Firebase Admin SDK. Project ID is required.
# Leave client email and private key blank when using Application Default
# Credentials locally or the Cloud Run service identity in production.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web app — public identifiers used by Firebase Authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

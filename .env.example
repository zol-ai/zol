# =============================================================================
# ZOL — environment template
#
# Copy to web/.env.local and fill in — that is the directory Next.js loads
# env files from; a .env at the repo root is read by nothing. This file is the
# tracked record of what the app expects. Never put a real secret in it.
# =============================================================================

# --- Feature flags -----------------------------------------------------------
# Master switch for anything that dials, answers, or texts. Leave false until
# Twilio carrier registration (A2P 10DLC brand + campaign) is approved. The
# webhooks fail closed while this is false.
ZOL_TELEPHONY_ENABLED=false

# Optional invite code for /signup. Unset means sign-up is open — that is the
# deliberate default, per the comment in actions/auth.ts. Set it to close the
# door without a deploy.
ZOL_SIGNUP_CODE=

# Public origin of the deployment. Twilio signs the URL it was configured to
# call, and behind Vercel/Cloud Run the inbound Host header is a proxy host —
# a mismatch here fails every signature check for non-obvious reasons.
ZOL_PUBLIC_URL=https://zol.ai

# --- Twilio ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WebSocket endpoint that terminates the call's media stream. This lives on
# Cloud Run, not Vercel — serverless functions won't hold a socket open for the
# length of a phone call. Leave empty until the realtime service is deployed.
ZOL_MEDIA_STREAM_URL=

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
# Overridable so changing model is a deploy, not a code change.
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Database ----------------------------------------------------------------
# Two ways in, and lib/db.ts picks based on whether INSTANCE_CONNECTION_NAME is
# set. Set one group or the other, not both.
#
# (a) Cloud SQL — production, on both Vercel and Cloud Run. The Node connector
#     mints short-lived certificates through the Admin API and dials the
#     instance directly, so nothing depends on an IP allowlist. Vercel's egress
#     IP changes constantly, which rules the allowlist out there anyway.
#     `infra/gcp-setup.ps1` prints these; `infra/vercel-env.ps1` pushes them.
INSTANCE_CONNECTION_NAME=
PGDATABASE=zol
PGUSER=zol
PGPASSWORD=
# PUBLIC (default) or PRIVATE. PRIVATE only works from inside the VPC — Cloud
# Run with a VPC connector. Vercel must stay PUBLIC.
CLOUD_SQL_IP_TYPE=PUBLIC
# Whole service-account key file, on one line. Only needed off-GCP: Cloud Run
# gets its identity from the metadata server and should leave this empty.
GCP_SERVICE_ACCOUNT_JSON=

# (b) Plain TCP — local Postgres, or the Cloud SQL Auth Proxy on localhost.
#     Ignored whenever INSTANCE_CONNECTION_NAME is set.
DATABASE_URL=postgresql://zol:password@localhost:5432/zol

# Per-instance pool ceiling. Serverless multiplies this by however many
# instances are warm, so keep it small or Cloud SQL runs out of connections.
DATABASE_POOL_MAX=5

# --- Speech (currently evaluating) -------------------------------------------
# Kept because the repo already carried a key. Drop it if OpenAI transcription
# wins the bake-off.
DEEPGRAM_API_KEY=

# --- Company OS (waitlist delivery) ------------------------------------------
# Waitlist submissions land in Postgres and are delivered to Company OS by
# `/api/waitlist/sweep`, which Cloud Scheduler calls every five minutes. The
# submission path itself never calls out — see CLAUDE.md in the parent folder.
#
# Company OS's Cloud Run origin. Doubles as the `audience` claim on the ID
# token, and the receiver compares that claim to its own URL exactly — a
# trailing slash or the wrong host is a 401, not a redirect.
COMPANY_OS_URL=
# The service account Cloud Scheduler presents when it calls the sweeper.
# Comma-separated if more than one. Unset means the sweeper refuses every
# request: a misconfigured deploy should deliver nothing, never run open.
COMPANY_OS_SCHEDULER_SERVICE_ACCOUNT=
# The audience Cloud Scheduler mints its token for. Must equal the scheduler
# job's --oidc-token-audience exactly — the full sweeper URL, path included,
# e.g. https://zol-web-XXXX.run.app/api/waitlist/sweep. Required; there is no
# fallback, because no origin-shaped default could ever match a value that
# carries a path.
COMPANY_OS_SWEEP_AUDIENCE=
# How far back the sweeper looks, and how many rows one invocation sends.
# The window is a ceiling on retries, not a retention policy: a row older than
# this stops being retried and needs a person to look at it.
COMPANY_OS_SWEEP_WINDOW_DAYS=7
COMPANY_OS_SWEEP_BATCH_SIZE=50

# --- Waitlist read endpoint (reconciliation) ---------------------------------
# GET /api/waitlist/entries is a read-only window onto waitlist_entries so
# Company OS can reconcile against it. Nothing is duplicated — Postgres stays
# the source of truth, and the endpoint returns the same envelopes the sweeper
# sends, built by the same function.
#
# Service accounts allowed to read the queue — Company OS's runtime identity.
# A different caller from the sweeper's, so a different list: Cloud Scheduler
# calls into the sweeper, Company OS calls into this. Unset means nobody.
WAITLIST_READ_ALLOWED_SERVICE_ACCOUNTS=
# The audience Company OS mints its token for. Defaults to ZOL_PUBLIC_URL.
WAITLIST_READ_AUDIENCE=
# Rows per page, and the ceiling a caller may ask for.
WAITLIST_READ_PAGE_SIZE=100
WAITLIST_READ_MAX_PAGE_SIZE=500
# The floor of the reconciliation window — rows updated before this are never
# returned. Set it to the moment migration 0005 ran: that migration marked the
# pre-integration back catalogue out of scope, and this is what keeps a
# reconciliation run from replaying it into Company OS. Required; the endpoint
# refuses to serve without it.
WAITLIST_READ_MIN_UPDATED_AT=

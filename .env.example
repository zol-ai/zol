# Reserved for a future Auth.js migration; not used by the Firebase-only MVP.
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Google OAuth configuration is managed in Firebase Authentication for this MVP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ALLOWED_EMAILS=founder1@example.com,founder2@example.com
COMPANY_TIME_ZONE=America/Los_Angeles

# Company Brain — server only. Never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Firebase Admin SDK. Project ID is required.
# Leave client email and private key blank when using Application Default
# Credentials locally or the Cloud Run service identity in production.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web app — public identifiers used by Firebase Authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Inbound events from tryzol.com ------------------------------------------
# POST /api/events is the only route not behind a Firebase session. It
# authenticates a service account by Google OIDC ID token instead of a person.
#
# This service's own public URL. The caller mints its token for this exact
# string and the route compares it character for character — a trailing slash
# or the wrong host is a 401, not a redirect.
EVENTS_AUDIENCE=
# Service accounts allowed to POST events, comma-separated. Kept separate from
# ALLOWED_EMAILS on purpose: one gates people, the other gates machines, and a
# shared list eventually lets a session reach ingest or a robot reach the
# workspace. Unset means nobody — a misconfigured deploy ingests nothing rather
# than accepting anything.
EVENTS_ALLOWED_SERVICE_ACCOUNTS=

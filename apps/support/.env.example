# Copy to .env.local for local dev. Never commit real values.

# Public HTTPS origin Twilio can reach. Locally this is your ngrok/cloudflared
# tunnel URL; on Cloud Run it is the service URL.
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app

# Twilio — console.twilio.com → Account info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567

# OpenAI
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_VOICE=marin
# OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Postgres for the calls dashboard. Leave unset to run the agent without logging.
DATABASE_URL=postgres://user:pass@host:5432/zol_support

# Forward-to-human number (E.164). Unset = agent offers a callback instead.
HANDOFF_PHONE_NUMBER=+15559876543

# Record every call (agent discloses it in the greeting). Default true.
RECORD_CALLS=true

# Shared password for the dashboard and settings page. Required in production.
DASHBOARD_PASSWORD=

# Local tunnels only. Never set in production.
# SKIP_TWILIO_SIGNATURE=true
